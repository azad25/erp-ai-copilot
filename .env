# ERP AI Copilot Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=erp_ai_copilot
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/erp_ai_copilot

# MongoDB Configuration
MONGODB_URI=mongodb://root:password@mongodb:27017/
MONGODB_DATABASE=erp_ai_conversations

# Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# Message Queue
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_PREFIX=ai-copilot

# LLM Service Configuration

# Ollama (Local Models)
OLLAMA_BASE_URL=http://172.17.0.1:11434

# OpenAI (GPT Models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude Models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Google Models)
GEMINI_API_KEY=AIzaSyDe79kNlJ_lGUXO5e-qka73mUpcvrynsBc

# Default Provider Selection
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_MODEL=llama2

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=INFO

# Auth Service Configuration
AUTH_SERVICE_GRPC_HOST=erp-suite-auth-service
AUTH_SERVICE_GRPC_PORT=50051
AUTH_SERVICE_GRPC_USE_SSL=false
AUTH_SERVICE_GRPC_TIMEOUT=10
AUTH_SERVICE_GRPC_MAX_RETRIES=3
LOG_FILE=/tmp/erp-copilot.log

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis (for caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
REDIS_URL=redis://:redispassword@redis:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

#Auth service host
AUTH_SERVICE_HOST=auth-service
